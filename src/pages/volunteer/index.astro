---
import { Picture } from "astro:assets";
import Button from "@components/Button.astro";
import Layout from "@layouts/Layout.astro";
import volunteersImg from "./images/volunteers.jpg";
---

<Layout
	title="Volunteers | Cloud Native Days Austria"
	description="Become a volunteer at Cloud Native Days Austria and help us build the cloud native community."
>
	<article>
		<h1>Become a Volunteer</h1>

		<section class="intro">
			<Picture
				src={volunteersImg}
				alt="Volunteers at Cloud Native Days Austria"
				formats={["avif", "webp"]}
				loading="eager"
				widths={[300, 400, 550]}
				pictureAttributes={{ class: "intro-image" }}
			/>
			<p>
				Cloud Native Days Austria is a community-focused event, and it takes a community to run
				it. We rely on volunteers to make this conference happen, and we're grateful for everyone
				who wants to get involved behind the scenes.
				<br/><br/>
				As a thank you for your support, we offer a few benefits.
			</p>
		</section>

		<section class="benefits">
			<h2>What you get</h2>
			<ul>
				<li>Free entrance to both conference days and the evening event</li>
				<li>Volunteer T-shirt</li>
				<li>Free food and drinks</li>
				<li>Free parking ticket</li>
			</ul>
		</section>

		<p>
			Depending on how many volunteers we have in the respective areas, the shifts will last around
			6 hours. We will send you your exact schedule at least 2 weeks before the event.
		</p>

		<p>
			If you are interested in volunteering, please fill out the registration form below. If you are
			unable to attend for any reason, please let us know as soon as possible so that we can find a
			replacement.
		</p>

		<Button href="https://docs.google.com/forms/d/e/1FAIpQLSd5SuG97o9Tpv--mxHZvpMUdRCBXzjR_efdd4w1quv4HhHYRQ/viewform?usp=sharing&ouid=105720773740966058131" external>
			Register as a Volunteer
		</Button>
	</article>
</Layout>

<style>
	article {
		max-width: 860px;
		margin-inline: auto;
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
	}

	h1 {
		text-align: center;
	}

	.benefits {
		background: var(--color-bg-light);
		border-radius: var(--radius);
		padding: var(--space-6);
	}

	ul {
		margin-top: var(--space-3);
		list-style: disc;
		padding-inline-start: var(--space-6);
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.intro {
		display: flex;
		gap: var(--space-6);
		align-items: flex-start;
	}

	.intro-image {
		width: 50%;
		flex-shrink: 0;
		border-radius: var(--radius);
		overflow: hidden;
	}

	.intro-image img {
		width: 100%;
		height: auto;
		display: block;
	}

	a {
		align-self: center;
	}

	@media (max-width: 600px) {
		.intro {
			flex-direction: column;
		}

		.intro-image {
			width: 100%;
		}
	}
</style>
