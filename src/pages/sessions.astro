---
import Button from "@components/Button.astro";
import SessionTimeline from "@components/SessionTimeline.astro";
import Layout from "@layouts/Layout.astro";
---

<Layout title="Sessions | Cloud Native Days Austria" description="Browse all conference sessions">
	<h1>Sessions of 2026</h1>
	<Button href="https://cloud-native-days-austria-2026.sessionize.com/schedule" external
		>Pick your favorite talks</Button
	>
	<SessionTimeline />

	<style>
		h1 {
			text-align: center;
			margin-bottom: var(--space-8);
		}

		:global(main > a[data-variant]) {
			display: block;
			width: fit-content;
			margin-inline: auto;
			margin-bottom: var(--space-8);
		}
	</style>
</Layout>
