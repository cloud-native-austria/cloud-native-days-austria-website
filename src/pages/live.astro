---
import Layout from "@layouts/Layout.astro";
import Button from "@components/Button.astro";
import FloorPlan from "@components/home/Venue/FloorPlan.astro";
import SessionsTimeline from "@components/SessionsTimeline.astro";
import { getCollection } from "astro:content";

const title = "CNDA 2026 - Live";
const description = "Everything you need to know at the event.";

const speakers = await getCollection("speakers");
const speakersById = new Map(speakers.map((entry) => [entry.data.id, entry.data]));

const sessions = (await getCollection("sessions"))
	.map((entry) => ({
		...entry.data,
		speakers: entry.data.speakers.map((speaker) => ({
			...speaker,
			profilePicture: speakersById.get(speaker.id)?.profilePicture,
		})),
		anchorId: `session-${entry.data.id}`,
	}))
	.sort((a, b) => {
		if (!a.startsAt && !b.startsAt) return 0;
		if (!a.startsAt) return 1;
		if (!b.startsAt) return -1;
		return new Date(a.startsAt).getTime() - new Date(b.startsAt).getTime();
	});

const sessionSpeakerIds = new Set(
	sessions.flatMap((session) => session.speakers.map((speaker) => speaker.id)),
);
const sessionSpeakers = speakers
	.map((entry) => entry.data)
	.filter((speaker) => sessionSpeakerIds.has(speaker.id));

const talkRoomIds = new Set(
	sessions.filter((session) => !session.isServiceSession).map((session) => session.roomId),
);
const laneRooms = (await getCollection("rooms"))
	.map((entry) => entry.data)
	.sort((a, b) => a.sort - b.sort)
	.filter((room) => talkRoomIds.has(room.roomId));

const leftRoom = laneRooms[0] ?? null;
const rightRoom = laneRooms[1] ?? null;

function getRoomSide(roomId: number | null): "left" | "right" | "center" {
	if (roomId !== null && roomId === leftRoom?.roomId) return "left";
	if (roomId !== null && roomId === rightRoom?.roomId) return "right";
	return "center";
}

function formatSessionTime(startsAt: string | null): string | null {
	if (!startsAt) return null;
	return new Date(startsAt).toLocaleTimeString("en-AT", {
		hour: "2-digit",
		minute: "2-digit",
		timeZone: "Europe/Vienna",
	});
}

function getDay(startsAt: string | null): string | null {
	if (!startsAt) return null;
	return new Date(startsAt).toLocaleDateString("en-AT", {
		weekday: "long",
		year: "numeric",
		month: "long",
		day: "numeric",
		timeZone: "Europe/Vienna",
	});
}

const sessionsWithMeta = sessions.map((s) => ({
	...s,
	side: getRoomSide(s.roomId),
	formattedTime: formatSessionTime(s.startsAt),
	formattedEndTime: formatSessionTime(s.endsAt),
}));

type TimeSlot = { left: typeof sessionsWithMeta[0] | null; right: typeof sessionsWithMeta[0] | null; center: typeof sessionsWithMeta };

const slotMap = new Map<string, TimeSlot>();
for (const session of sessionsWithMeta) {
	const key = session.startsAt ?? `__unscheduled_${session.id}`;
	if (!slotMap.has(key)) slotMap.set(key, { left: null, right: null, center: [] });
	const slot = slotMap.get(key)!;
	if (session.side === "left") slot.left = session;
	else if (session.side === "right") slot.right = session;
	else slot.center.push(session);
}
const timeSlots = [...slotMap.values()];

type DayGroup = { day: string | null; slots: TimeSlot[] };
const dayGroups: DayGroup[] = [];
for (const slot of timeSlots) {
	const firstSession = slot.left ?? slot.right ?? slot.center[0];
	const day = firstSession ? getDay(firstSession.startsAt) : null;
	const last = dayGroups.at(-1);
	if (!last || last.day !== day) {
		dayGroups.push({ day, slots: [slot] });
	} else {
		last.slots.push(slot);
	}
}
---

<Layout title={title} description={description}>
	<header>
		<h1>{title}</h1>
	</header>

	<div>
		<section>
			<h2>Current and upcoming sessions</h2>
			<SessionsTimeline
				dayGroups={dayGroups}
				sessionSpeakers={sessionSpeakers}
				leftRoom={leftRoom}
				rightRoom={rightRoom}
				liveMode
			/>
			<div class="sessions-button-wrap">
				<Button href="https://cloud-native-days-austria-2026.sessionize.com/schedule" external>Pick your favorite talks</Button>
			</div>
		</section>

		<section class="floorplan-section">
			<FloorPlan />
		</section>

		<section>
			<h2>Wi-Fi access</h2>
			<table>
				<tbody>
					<tr>
						<td>SSID</td>
						<td>CNDA-conference</td>
					</tr>
					<tr>
						<td>Password</td>
						<td>stay-cloud-native!</td>
					</tr>
				</tbody>
			</table>
		</section>

		<section>
			<h2>Emergency numbers</h2>
			<table>
				<tbody>
					<tr>
						<td>Fire service</td>
						<td><a href="tel:122">122</a></td>
					</tr>
					<tr>
						<td>Police</td>
						<td><a href="tel:133">133</a></td>
					</tr>
					<tr>
						<td>Ambulance</td>
						<td><a href="tel:144">144</a></td>
					</tr>
				</tbody>
			</table>
		</section>
	</div>
</Layout>

<style>
	header {
		text-align: center;
		margin-bottom: var(--space-8);
	}

	header h1 {
		font-family: var(--font-heading);
		font-size: var(--text-3xl);
		color: var(--color-text);
		margin-bottom: var(--space-4);
	}

	header p {
		font-size: var(--text-base);
		color: var(--color-text);
	}

	div {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-6);
	}

	section {
		background: var(--color-bg-light);
		border-radius: var(--radius);
		padding: var(--space-6);
		text-align: center;
	}

	section:first-child,
	.floorplan-section {
		grid-column: 1 / -1;
		text-align: left;
		background: transparent;
		padding: 0;
	}

	section:first-child :global(.day-separator) {
		display: none;
	}

	section:first-child :global(.timeline) {
		padding-top: var(--space-8);
	}

	section:first-child :global(.timeline::before),
	section:first-child :global(.timeline::after) {
		top: var(--space-8);
		bottom: var(--space-6);
	}

	section:first-child :global(.lane-labels) {
		display: grid;
	}

	.sessions-button-wrap {
		display: flex;
		justify-content: center;
		margin-top: var(--space-6);
		position: relative;
		z-index: 1;
	}

	section h2 {
		font-family: var(--font-heading);
		font-size: var(--text-lg);
		margin-bottom: var(--space-4);
	}

	section:first-child h2 {
		text-align: center;
		margin-bottom: var(--space-6);
	}

	/* Table styles for Wi-Fi and Emergency sections */
	table {
		margin: 0 auto;
		border-spacing: var(--space-3);
	}

	td:first-child {
		text-align: right;
		font-weight: 600;
		padding-right: var(--space-4);
	}

	td:last-child {
		text-align: left;
	}

	a {
		color: var(--color-accent);
		text-decoration: none;
	}

	a:hover {
		color: var(--color-pink);
	}

	@media (max-width: 768px) {
		div {
			grid-template-columns: 1fr;
		}
	}
</style>
