---
import Button from "@components/Button.astro";
import PersonCard from "@components/PersonCard.astro";
import SpeakerDetailModal from "@components/SpeakerDetailModal.astro";
import { getCollection } from "astro:content";

const displayedSpeakers = (await getCollection("speakers"))
	.map((entry) => entry.data)
	.filter((s) => s.isTopSpeaker)
	.slice(0, 4);
---

<section aria-labelledby="tickets">
	<h2 id="tickets">Tickets</h2>
	<div>
		<div class="speakers">
			<ul>
				{
					displayedSpeakers.map((speaker) => (
						<li>
							<SpeakerDetailModal speaker={speaker} />
							<button
								type="button"
								commandfor={`speaker-${speaker.id}`}
								command="show-modal"
								data-speaker-target={`speaker-${speaker.id}`}
								aria-label={`View details for ${speaker.fullName}`}
							>
								<PersonCard
									name={speaker.fullName}
									image={speaker.profilePicture}
									showMeta={false}
									sizes="(max-width: 768px) 80px, 120px"
								/>
							</button>
						</li>
					))
				}
			</ul>
			<p class="speakers-label">Keynote Speakers</p>
		</div>

		<div>
			<p>
				The conference pass gives you access to all <a href="/sessions">sessions</a> on both days and
				the{' '}
				<strong>evening event</strong>.
			</p>

			<Button href="https://cloud-native-days-austria-2026.sessionize.com/schedule" external variant='outline'>Pick your favorite talks</Button>
			<Button href="https://tickets.cloudnativedays.at" external> Get your conference pass </Button>
		</div>
	</div>
</section>

<style>
	section {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-4);
		background:
			linear-gradient(var(--color-white), var(--color-white)) padding-box,
			var(--gradient-brand) border-box;
		border: 2px solid transparent;
		border-radius: var(--radius);
		padding: var(--space-6) var(--space-4);
		box-shadow: var(--shadow-elevated);
	}

	h2 {
		text-align: center;
	}

	section > div {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: var(--space-6);
		width: 100%;
		max-width: var(--container);
		margin-inline: auto;
	}

	.speakers {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-2);
	}

	.speakers-label {
		font-family: var(--font-heading);
		font-size: 0.85rem;
		color: var(--color-muted, currentColor);
		opacity: 0.6;
		margin: 0;
	}

	section > div > .speakers > ul {
		display: flex;
		justify-content: center;
		align-items: center;
		max-width: 700px;
		padding: 0;
		margin: 0;
	}

	ul > li {
		list-style: none;
	}

	ul > li:not(:first-child) {
		margin-left: -24px;
	}

	ul > li > button {
		display: block;
		all: unset;
		cursor: pointer;
		position: relative;
		width: 80px;
		flex-shrink: 0;
		transform-origin: center bottom;
		transform: translateY(calc(var(--base-y, 0px) + var(--lift, 0px))) rotate(var(--tilt, 0deg));
		transition: transform 0.2s ease;
	}

	ul > li > button:hover {
		--lift: -10px;
		z-index: 6;
	}

	ul > li > button:focus-visible {
		--lift: -10px;
		z-index: 6;
		outline: 2px solid var(--color-accent);
		outline-offset: 4px;
		border-radius: var(--radius);
	}

	@media (min-width: 768px) {
		ul > li > button {
			width: 120px;
		}

		ul > li:not(:first-child) {
			margin-left: -36px;
		}
	}

	ul > li:nth-child(1) {
		--base-y: 8px;
		--tilt: -8deg;
		z-index: 1;
	}

	ul > li:nth-child(2) {
		--base-y: 2px;
		--tilt: -3deg;
		z-index: 2;
	}

	ul > li:nth-child(3) {
		--base-y: 2px;
		--tilt: 3deg;
		z-index: 3;
	}

	ul > li:nth-child(4) {
		--base-y: 8px;
		--tilt: 8deg;
		z-index: 4;
	}

	section > div > div:last-child {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-2);
		min-width: 300px;
	}

	p {
		max-width: 34ch;
	}

	p > a {
		color: var(--color-accent);
	}

	p > a:hover,
	p > a:focus-visible {
		color: var(--color-pink);
	}

	a {
		font-weight: 600;
	}

	span {
		color: var(--color-pink);
		font-weight: 600;
	}

	@media (prefers-reduced-motion: reduce) {
		ul > li > button {
			transition: none;
		}

		ul > li > button:hover,
		ul > li > button:focus-visible {
			--lift: 0;
		}
	}
</style>
