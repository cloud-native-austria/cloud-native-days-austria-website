</section>

<style>
	section {
		text-align: center;
	}

	h2 {
		margin-bottom: var(--space-2);
	}

	p {
		color: var(--color-text-light);
	}

	.timeline {
		--dot-col: 32px;
		max-width: 560px;
		margin: var(--space-10) auto 0;
		text-align: left;
	}

	/* Line lives on .commits and extends just into the origin row to meet its dot */
	.commits {
		position: relative;
	}

	.commits::before {
		content: "";
		position: absolute;
		left: calc(var(--dot-col) / 2 - 1px);
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--color-gray);
	}

	.row {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		padding-block: var(--space-3);
	}

	.dot {
		flex-shrink: 0;
		width: var(--dot-col);
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		z-index: 1;
	}

	.dot::after {
		content: "";
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--color-accent);
		display: block;
	}

	.origin .dot::after {
		display: none;
	}

	.origin .dot {
		color: var(--color-accent);
	}

	.origin .dot svg {
		display: block;
	}

	.origin {
		position: relative;
		font-family: var(--font-heading);
		font-size: var(--text-sm);
		color: var(--color-text-light);
	}

	/* Draws the line from the top of the origin row to its dot center */
	.origin::before {
		content: "";
		position: absolute;
		left: calc(var(--dot-col) / 2 - 1px);
		top: 0;
		height: 50%;
		width: 2px;
		background: var(--color-gray);
	}

	.combined {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-1) var(--space-2);
	}

	.row a {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		text-decoration: none;
		color: var(--color-text);
		transition: color var(--transition-fast);
	}

	.row a svg {
		flex-shrink: 0;
		display: block;
	}

	.row a:hover {
		color: var(--color-accent);
	}
</style>
