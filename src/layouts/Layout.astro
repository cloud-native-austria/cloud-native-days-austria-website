---
import "@styles/global.css";
import { Font } from "astro:assets";
import Header from "@components/Header/Header.astro";
import Footer from "@components/Footer.astro";

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const { title, description = "Experience the power of community at Cloud Native Days Austria!" } =
	Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/social-preview.png", Astro.site);
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="color-scheme" content="light dark" />
		<link rel="canonical" href={canonicalURL} />

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={ogImage} />

		<Font cssVariable="--font-plus-jakarta-sans" preload />
		<Font cssVariable="--font-fira-code" preload />

		<script>
			const l = "font-family: monospace; font-size: 2em; font-weight: bold; padding: 0 4px;";
			console.log(
				"%cC%cN%cD%cA",
				l + "color: #531cb3;",
				l + "color: #e30282;",
				l + "color: #ffbc42;",
				l + "color: #0ea5e9;"
			);
			console.log(
				"%cYou seem to be more of a terminal user. Get all infos about the event by using cndactl\nhttps://npmx.dev/package/cndactl",
				"font-size: 14px; color: #0ea5e9;"
			);
		</script>
	</head>
	<body>
		<Header />

		<main id="main-content">
			<slot />
		</main>

		<Footer />
	</body>
</html>

<style>
	body {
		display: flex;
		flex-direction: column;
		min-block-size: 100svh;
	}

	main {
		flex: 1;
		width: 100%;
		max-width: var(--container);
		margin-inline: auto;
		padding: var(--space-8) var(--page-inline-padding);
	}
</style>
