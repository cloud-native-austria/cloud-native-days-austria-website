---
import "@styles/global.css";
import SponsorColumn from "@components/SponsorColumn.astro";
import { Font } from "astro:assets";

interface Props {
	title: string;
	rotation?: string;
}

const { title, rotation } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="color-scheme" content="light" />
		<meta name="robots" content="noindex" />
		<title>{title}</title>
		<Font cssVariable="--font-plus-jakarta-sans" preload />
		<Font cssVariable="--font-fira-code" preload />
	</head>
	<body>
		<div class="content">
			<div class="schedule-area">
				<div class="scroll-area">
					<main>
					<slot />
					<div class="now-marker" aria-hidden="true">
						<span class="now-label"></span>
					</div>
				</main>
					<span class="fade fade-top" aria-hidden="true"></span>
					<span class="fade fade-bottom" aria-hidden="true"></span>
				</div>
			</div>

			<aside class="sponsor-pane" aria-label="Sponsors">
				<SponsorColumn rotation={rotation} />
			</aside>
		</div>
	</body>
</html>

<script>
	const HOLD_TOP = 8_000;
	const SCROLL_DOWN = 20_000;
	const HOLD_BOTTOM = 3_000;
	const SCROLL_UP = 1_200;

	const main = document.querySelector("main") as HTMLElement;

	const easeIn  = (t: number) => t * t;
	const easeOut = (t: number) => 1 - (1 - t) * (1 - t);

	function animateScroll(
		from: number,
		to: number,
		duration: number,
		ease: (t: number) => number,
	): Promise<void> {
		return new Promise((resolve) => {
			const max = main.scrollHeight - main.clientHeight;
			const start = performance.now();
			function step(now: number) {
				const t = Math.min(1, (now - start) / duration);
				main.scrollTop = max * (from + (to - from) * ease(t));
				if (t < 1) requestAnimationFrame(step);
				else resolve();
			}
			requestAnimationFrame(step);
		});
	}

	async function loop() {
		while (true) {
			main.scrollTop = 0;
			await new Promise((r) => setTimeout(r, HOLD_TOP));
			await animateScroll(0, 1, SCROLL_DOWN, easeIn);
			await new Promise((r) => setTimeout(r, HOLD_BOTTOM));
			await animateScroll(1, 0, SCROLL_UP, easeOut);
		}
	}

	document.fonts.ready.then(loop);
</script>

<script>
	const marker = document.querySelector(".now-marker") as HTMLElement;
	const label  = marker.querySelector(".now-label") as HTMLElement;

	function updateNowMarker() {
		const now = Date.now();
		const slots = [...document.querySelectorAll<HTMLElement>(".time-slot[data-starts-at]")];
		if (!slots.length) return;

		// Find the slot that straddles "now"
		let target: HTMLElement | null = null;
		let progress = 0;

		for (let i = 0; i < slots.length; i++) {
			const start = new Date(slots[i].dataset.startsAt!).getTime();
			const end   = slots[i].dataset.endsAt ? new Date(slots[i].dataset.endsAt!).getTime() : null;
			const nextStart = slots[i + 1]?.dataset.startsAt ? new Date(slots[i + 1].dataset.startsAt!).getTime() : null;
			const slotEnd = end ?? nextStart ?? start;

			if (now >= start && now < slotEnd) {
				target = slots[i];
				progress = slotEnd > start ? (now - start) / (slotEnd - start) : 0;
				break;
			}
		}

		if (!target) {
			marker.classList.remove("visible");
			return;
		}

		// offsetTop is in pre-zoom CSS pixels — the marker lives inside the same
		// zoomed container so no correction needed
		const top = target.offsetTop + target.offsetHeight * progress;
		marker.style.top = `${top}px`;
		marker.classList.add("visible");

		const time = new Date().toLocaleTimeString("en-AT", { hour: "2-digit", minute: "2-digit", timeZone: "Europe/Vienna" });
		label.textContent = time;
	}

	updateNowMarker();
	setInterval(updateNowMarker, 30_000);
</script>

<style>
	body {
		display: grid;
		grid-template-rows: minmax(0, 1fr);
		block-size: 100svh;
		margin: 0;
		overflow: hidden;
	}

	.content {
		display: grid;
		grid-template-columns: 1fr var(--sponsor-col-width, 300px);
		min-block-size: 0;
	}

	.schedule-area {
		display: grid;
		grid-template-rows: minmax(0, 1fr);
		min-block-size: 0;
		overflow: hidden;
	}

	.scroll-area {
		position: relative;
		min-block-size: 0;
	}

	main {
		position: relative;
		block-size: 100%;
		overflow-y: auto;
		padding-block-start: var(--space-16);
		padding-block-end: calc(var(--space-16) * 2);
		padding-inline: var(--space-6);
		scrollbar-width: none;
		pointer-events: none;
		user-select: none;
		zoom: 1.4;
	}

	main > :global(*) {
		max-inline-size: 1300px;
		margin-inline: auto;
	}

	main::-webkit-scrollbar {
		display: none;
	}

	main :global(.timeline) {
		padding-block-start: 0;
	}

	.now-marker {
		position: absolute;
		inset-inline: 0;
		height: 2px;
		background: var(--color-pink);
		pointer-events: none;
		display: none;
	}

	.now-marker.visible {
		display: block;
	}

	.now-label {
		position: absolute;
		right: var(--space-2);
		top: 50%;
		transform: translateY(-50%);
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--color-pink);
		background: var(--color-white);
		padding-inline: var(--space-1);
		line-height: 1;
	}

	main :global(.day-separator) {
		display: none;
	}

	.fade {
		position: absolute;
		inset-inline: 0;
		block-size: var(--space-8);
		pointer-events: none;
		z-index: 5;
	}

	.fade-top {
		top: 0;
		background: linear-gradient(to bottom, var(--color-white), transparent);
	}

	.fade-bottom {
		bottom: 0;
		background: linear-gradient(to top, var(--color-white), transparent);
	}

	.sponsor-pane {
		position: relative;
		background: #fff;
		color-scheme: light;
		padding-inline: var(--space-6);
	}

	.sponsor-pane::before {
		content: "";
		position: absolute;
		inset-block: 0;
		left: 0;
		width: 3px;
		background: var(--gradient-brand);
	}
</style>
